BOT_TOKEN=
BOT_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-domain.vercel.app
# Supabase on Vercel: use Connect > Transaction pooler (port 6543), not db.*:5432.
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres
DATABASE_ENABLED=false
AUTO_CREATE_TABLES=false
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=123456789
WEBHOOK_PATH=/api/telegram/webhook
SESSION_TTL_MINUTES=120
RATE_LIMIT_PER_MINUTE=12
WORKER_CALLBACK_SECRET=replace-with-a-long-random-secret
WORKER_URL=https://your-worker.example.com
